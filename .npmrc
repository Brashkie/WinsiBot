# Sin instalar solas las dependencias "peer". La unica que entraba asi es
# sharp (con sus 26 binarios de @img), que Baileys pide como peer pero no
# necesita: lo importa con .catch() para las miniaturas y la foto de perfil,
# y el bot las hace antes con la Session API (src/lib/mediaThumb.ts y
# #setpp). WinsiBot no usa sharp desde la 9.4.0: 30 MB menos en disco y
# nada que compilar en Termux.
legacy-peer-deps=true
