{
  "name": "winsi-bot",
  "version": "8.12.0",
  "description": "WinsiBot v8.12.0 - High-performance WhatsApp bot (TypeScript + Rust), advanced AI, RPG economy and resilience for very active groups. Python is no longer required to install or run it: the bot makes zero calls to it, and the two console tools that remain compile to native executables with Nuitka. Installing is `npm install` and nothing else - the Rust Session API binary is fetched prebuilt for your platform (5 targets, Termux included) with its SHA-256 verified, instead of a ~4 minute cargo build that needed Rust installed. The three image commands moved to Rust with the `ort` crate: #toanime goes from 3.7 GB of torch to an 8 MB ONNX model, #removebg keeps the same isnetis model, and #upscale is Anime4K ported - no model to download and no temp files, 175 ms. ONNX Runtime is linked statically, so the binary is still a single file. Thirteen real bugs fixed along the way, among them: `npm run build` never cleaned `dist/`, so 35 command keys were served by source-less code including two removed seven releases earlier; /ml/predict/spam was deleting legitimate messages; the Session API could not start if you followed `.env.example`; and the `trusted` reputation tier was unreachable. 140 Rust unit tests, up from zero.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fetch_rust.js",
    "rust:fetch": "node scripts/fetch_rust.js",
    "prestart": "npm run build",
    "start": "node dist/supervisor.js",
    "start:unsupervised": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "node scripts/setup.js",
    "status": "node scripts/status.js",
    "monitor": "node scripts/monitor.js",
    "manage": "node scripts/manage.js",
    "manage:status": "node scripts/manage.js status",
    "manage:diagnose": "node scripts/manage.js diagnose",
    "manage:repair": "node scripts/manage.js repair",
    "manage:reset-signal": "node scripts/manage.js reset-signal",
    "manage:reset-qr": "node scripts/manage.js reset-qr",
    "manage:backup": "node scripts/manage.js backup",
    "manage:restore": "node scripts/manage.js restore",
    "manage:logs": "node scripts/manage.js logs",
    "users:export": "node scripts/users.js export",
    "users:import": "node scripts/users.js import",
    "users:stats": "node scripts/users.js stats",
    "build": "rimraf dist && tsc && tsc-alias",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "rust:build": "cd rust && cargo build --release",
    "rust:start": "cd rust && cargo run --release",
    "lint": "biome lint src/ scripts/",
    "lint:fix": "biome lint --write src/ scripts/",
    "format": "biome format src/ scripts/",
    "format:fix": "biome format --write src/ scripts/",
    "check": "biome check src/ scripts/",
    "check:fix": "biome check --write src/ scripts/",
    "rust:lint": "cd rust && cargo clippy --release",
    "rust:test": "cd rust && cargo test --release",
    "rust:bench": "cd rust && cargo bench",
    "py:lint": "node scripts/py_lint.js",
    "py:deps": "node scripts/py_deps.js",
    "tools:build": "node scripts/build_tools.js",
    "py:lint:fix": "node scripts/py_lint.js --fix",
    "py:format": "node scripts/py_format.js",
    "lint:all": "npm run lint && npm run rust:lint && npm run py:lint && npm run py:deps",
    "qr": "node dist/index.js qr",
    "code": "node dist/index.js code",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "chaos": "node scripts/chaos.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "health": "node scripts/health.js",
    "ai:test": "node scripts/ai_test.js"
  },
  "homepage": "https://github.com/Brashkie/WinsiBot",
  "author": {
    "name": "Hepein Oficial",
    "email": "support@hepein.dev",
    "url": "https://hepein.dev"
  },
  "directories": {
    "lib": "src/lib",
    "src": "src",
    "plugins": "src/plugins",
    "database": "src/database"
  },
  "keywords": [
