{
  "name": "winsi-bot",
  "version": "9.1.0",
  "description": "WinsiBot v9.1.0 - Ultralight WhatsApp bot with its own local AI: Cosxamix, downloaded and started by the bot itself, answers by default with no API key and no Ollama. TypeScript core, Rust Session API, and C and Zig kernels (AVX2 copy picked at startup). Speaks Spanish, English and Portuguese; RPG economy, group cave exploration, arena with a Monte Carlo simulator, audio effects and image tools. Install is `npm install` and nothing else: the Session API binary is fetched prebuilt for your platform, Termux included, with its SHA-256 verified.",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fetch_rust.js && node scripts/fetch_cosxamix.js",
    "rust:fetch": "node scripts/fetch_rust.js",
    "cosxamix:fetch": "node scripts/fetch_cosxamix.js --siempre",
    "cosxamix:model": "node scripts/cosxamix_model.js",
    "prestart": "npm run build",
    "start": "node dist/supervisor.js",
    "start:unsupervised": "node --max-semi-space-size=4 dist/index.js",
    "dev": "tsx src/index.ts",
    "setup": "node scripts/setup.js",
    "status": "node scripts/status.js",
    "manage": "node scripts/manage.js",
    "manage:status": "node scripts/manage.js status",
    "manage:diagnose": "node scripts/manage.js diagnose",
    "manage:repair": "node scripts/manage.js repair",
    "manage:reset-signal": "node scripts/manage.js reset-signal",
    "manage:reset-qr": "node scripts/manage.js reset-qr",
    "manage:backup": "node scripts/manage.js backup",
    "manage:restore": "node scripts/manage.js restore",
    "manage:logs": "node scripts/manage.js logs",
    "users:export": "node scripts/users.js export",
    "users:import": "node scripts/users.js import",
    "users:stats": "node scripts/users.js stats",
    "groups:export": "node scripts/users.js export --grupos",
    "groups:import": "node scripts/users.js import --grupos",
    "groups:stats": "node scripts/users.js stats --grupos",
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc && tsc-alias && node scripts/build_commands_manifest.js",
    "web:dev": "cd web && npm run dev",
    "web:build": "cd web && npm run build",
    "rust:build": "cargo build --release -p winsibot-session-api",
    "rust:start": "node -e \"require('fs').mkdirSync('data/session-api',{recursive:true})\" && cd data/session-api && cargo run --release -p winsibot-session-api --manifest-path ../../Cargo.toml",
    "lint": "biome lint src/ scripts/",
    "lint:fix": "biome lint --write src/ scripts/",
    "format": "biome format src/ scripts/",
    "format:fix": "biome format --write src/ scripts/",
    "check": "biome check src/ scripts/",
    "check:fix": "biome check --write src/ scripts/",
    "rust:lint": "cargo clippy --release -p winsibot-session-api",
    "rust:test": "cargo test --release -p winsibot-session-api",
    "rust:bench": "cargo bench -p winsibot-session-api",
    "native:build": "cargo build --release -p winsibot-session-api --features native",
    "native:test": "cargo test --release -p winsibot-session-api --features native",
    "native:bench": "cargo bench -p winsibot-session-api --features native --bench anime4k --bench codec",
    "cluster:test": "cargo test --release -p winsibot-cluster",
    "cluster:compare": "cargo run --release -p winsibot-cluster --example compare",
    "lint:all": "npm run lint && npm run rust:lint",
    "qr": "node --max-semi-space-size=4 dist/index.js qr",
    "code": "node --max-semi-space-size=4 dist/index.js code",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "chaos": "node scripts/chaos.js",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "ai:test": "node scripts/ai_test.js",
    "ai:bench": "node scripts/ollama_bench.js",
    "mem:profile": "node --expose-gc scripts/mem_profile.js",
    "bench:hops": "node scripts/bench_hops.js",
    "bench:api": "node scripts/bench_api.js"
  },
  "homepage": "https://github.com/Brashkie/WinsiBot",
  "author": {
    "name": "Hepein Oficial",
    "email": "support@hepein.dev",
    "url": "https://hepein.dev"
  },
  "directories": {
    "lib": "src/lib",
    "src": "src",
    "plugins": "src/plugins",
    "database": "src/database"
  },
  "keywords": [
    "whatsapp-bot",
    "typescript",
    "baileys-md",
    "multi-device",
    "openai",
    "cluster",
    "fast",
    "performance",
    "ai",
    "hepein",
    "music",
    "scraper",
    "bot"
  ],
  "bugs": {
    "url": "https://github.com/Brashkie/WinsiBot/issues"
  },
  "license": "GPL-3.0-or-later",
  "dependencies": {
    "@brashkie/signalis-core": "^0.5.1",
    "@hono/node-server": "^2.0.12",
    "@whiskeysockets/baileys": "^6.7.18",
    "ansimax": "^1.7.7",
    "axios": "^1.7.3",
    "cbor-x": "^1.6.4",
    "css-select": "^5.2.2",
    "hono": "^4.12.32",
    "htmlparser2": "^10.1.0",
    "pino": "^9.5.0",
    "strenor": "^0.5.3",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.4",
    "@types/node": "^20.19.39",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^2.1.3",
    "tsc-alias": "^1.8.17",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.2.0",
    "sharp": "^0.34.1"
  },
  "config": {
    "cosxamix": "0.7.0"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
