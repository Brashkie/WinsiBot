# winsibot-session-api — configuración propia de la API (OPCIONAL)
#
# Normalmente no hace falta: la API lee el .env de la raíz del proyecto, donde
# ya están SESSION_API_URL y SESSION_API_KEY, que son los mismos para el bot y
# para ella. El puerto sale de SESSION_API_URL.
#
# Si querés algo solo para la API, copiá este archivo a data/session-api/.env:
# el bot la arranca con esa carpeta como directorio de trabajo, y un .env ahí
# se lee primero. Las rutas relativas son relativas a data/session-api/.

# Nivel de logs: error | warn | info | debug | trace
RUST_LOG=winsibot_session_api=info,tower_http=info

# Dónde guarda cada cosa (estos son los valores por defecto):
# SESSIONS_DIR=./sessions
# DB_PATH=./data/messages.db
# CONV_DB_PATH=./data/ai_conversations.db
# MODELS_DIR=data/models
#
# AUTH_DIR no hace falta: el bot se lo pasa siempre, absoluto.
