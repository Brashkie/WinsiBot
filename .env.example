# Bot
PREFIX=!
BOT_NAME=WinsiBot
OWNER_JID=51999999999@s.whatsapp.net
SESSION_PATH=./auth

# Canal de WhatsApp propio (opcional) — si se define, el menú y otros mensajes
# reenviados muestran "Ver canal" apuntando a este newsletter. Si se deja
# vacío, ese contexto de reenvío simplemente no se arma.
NEWSLETTER_JID=

# Máximo de contactos en caché antes de rotar los más antiguos (LRU aproximado)
MAX_CONTACTS=20000

# APIs externas
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Ollama (IA local — gratis, sin API key, primera opción antes de GPT/Claude/Gemini)
# Requiere tener Ollama corriendo: https://ollama.com — luego `ollama pull llama3.2:3b`
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=40

# Rule34 (opcional — comandos nsfw/rule34*, funcionan sin esto pero con límites más bajos)
RULE34_API_KEY=
RULE34_USER_ID=

# Xbox Live / OpenXBL (opcional — comandos mcsearch/mcfriends/mcachievement)
# Conseguí tu propia key gratis en https://xbl.io/ (login con tu cuenta Xbox)
XBL_API_KEY=

# Rust Session API (winsibot-session-api)
#
# Estas dos las usan el cliente Y el servidor, con el mismo nombre. El puerto
# en el que la API escucha sale de SESSION_API_URL, así que se declara una vez
# y no hay forma de que cliente y servidor queden en puertos distintos.
# SESSION_API_KEY es obligatoria y necesita 32 caracteres como mínimo:
#   openssl rand -hex 32
SESSION_API_URL=http://127.0.0.1:3001
SESSION_API_KEY=

# Webhook receiver (opcional, puerto distinto al de Rust)
WEBHOOK_PORT=4001
WEBHOOK_SECRET=winsibot_secret

# Panel web (reemplaza al viejo panel PHP) — servido en este puerto,
# API + WebSocket + el build de web/ todo junto, mismo origen
DASHBOARD_PORT=4002

# Base de datos
DATABASE_URL=postgresql://winsi:password@localhost:5432/winsibot


# Misc
NODE_ENV=development
LOG_LEVEL=info