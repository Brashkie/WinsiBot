# Bot
PREFIX=!
BOT_NAME=WinsiBot
OWNER_JID=51999999999@s.whatsapp.net
SESSION_PATH=./auth

# Canal de WhatsApp propio (opcional) — si se define, el menú y otros mensajes
# reenviados muestran "Ver canal" apuntando a este newsletter. Si se deja
# vacío, ese contexto de reenvío simplemente no se arma.
NEWSLETTER_JID=

# Máximo de contactos en caché antes de rotar los más antiguos (LRU aproximado)
MAX_CONTACTS=20000

# APIs externas
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# IA local — gratis, sin API key, primera opción antes de GPT/Claude/Gemini.
#
# Hay dos servidores posibles y el bot les habla igual, porque Cosxamix imita
# el dialecto de Ollama: los mismos dos endpoints, /api/tags y
# /v1/chat/completions. Cambiar de uno a otro es cambiar estas tres líneas.
# Sin ninguna, se usa Cosxamix con el 3B.
#
# OPCIÓN A, la de por defecto desde la 9.0.0 — Cosxamix, el runtime propio:
# https://github.com/Brashkie/Cosxamix
#
#   1. `npm install` lo baja a bin/ (7,5 MB, la versión que dice package.json
#      en config.cosxamix).
#   2. `npm run cosxamix:model` baja el modelo, preguntando: elige el tamaño
#      según la RAM (el 3B desde 8 GB, el 1.5B desde 4, el 0.5B en lo demás)
#      y al terminar dice qué poner en OLLAMA_MODEL.
#   3. El bot lo arranca solo al iniciar, en segundo plano, y lo relanza si se
#      cae o se cuelga. Su log: data/cosxamix/cosxamix.log
#
# Qué cambia frente a Ollama, medido: Ollama descarga el modelo a los 5
# minutos de inactividad, y un bot de WhatsApp recibe mensajes de IA de forma
# esporádica, así que paga la recarga del disco en casi cada petición;
# Cosxamix lo deja cargado. Guarda la conversación de cada chat y no
# reprocesa el *system prompt* del bot en cada mensaje. Y desde Cosxamix 0.6.0
# responde con su motor propio: 1,6 a 1,9 veces más rápido por mensaje que con
# candle, y 11 de 15 aciertos contra 10.
#
# El timeout es de 60 s porque cargar el 3B tarda ~45: una petición que llegue
# durante la carga no se corta sola. Una vez caliente responde en 1-3 s.
OLLAMA_URL=http://127.0.0.1:11435
OLLAMA_MODEL=qwen2.5-3b-instruct-q3_k_m
OLLAMA_TIMEOUT=60
# Con candle, el motor de Cosxamix de antes de la 0.6.0 (el bot le pasa la
# variable tal cual):
# COSXAMIX_MOTOR=candle

# OPCIÓN B — Ollama: https://ollama.com y `ollama pull llama3.2:3b`.
# Comentá las tres de arriba y descomentá estas. El puerto es 11434, uno menos
# que el de Cosxamix, así que los dos pueden convivir mientras se compara.
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_TIMEOUT=40

# Rule34 (opcional — comandos nsfw/rule34*, funcionan sin esto pero con límites más bajos)
RULE34_API_KEY=
RULE34_USER_ID=

# Xbox Live / OpenXBL (opcional — comandos mcsearch/mcfriends/mcachievement)
# Conseguí tu propia key gratis en https://xbl.io/ (login con tu cuenta Xbox)
XBL_API_KEY=

# Rust Session API (winsibot-session-api)
#
# Estas dos las usan el cliente Y el servidor, con el mismo nombre. El puerto
# en el que la API escucha sale de SESSION_API_URL, así que se declara una vez
# y no hay forma de que cliente y servidor queden en puertos distintos.
# SESSION_API_KEY es obligatoria y necesita 32 caracteres como mínimo:
#   openssl rand -hex 32
SESSION_API_URL=http://127.0.0.1:3001
SESSION_API_KEY=

# Antiban (rust/src/antiban.rs) — el ritmo de salida de cada cuenta. Todo es
# opcional: sin estas lineas rigen los valores de abajo, pensados para un bot
# de cientos de grupos que responde comandos. Meta no publica sus umbrales, asi
# que son margenes y no numeros conocidos: para ajustarlos con datos, mirar
# cuanto envia el bot de verdad con GET /antiban/status?session=main.
#
# Topes de la cuenta en ventanas deslizantes. ANTIBAN_POR_DIA=0 es sin tope.
# ANTIBAN_POR_MINUTO=40
# ANTIBAN_POR_HORA=1000
# ANTIBAN_POR_DIA=0
# Tope de 24 h para cada dia desde que se VINCULA un numero (sub-bots, o el
# principal tras escanear). Las sesiones que ya existian no lo tienen. Vacio
# lo apaga.
# ANTIBAN_CALENTAMIENTO=40,80,160,320,640,1200,2400
# Pausa entre dos envios de la misma cuenta: normal con media y desvio, y piso.
# ANTIBAN_PAUSA_MEDIA_MS=900
# ANTIBAN_PAUSA_DESVIO_MS=350
# ANTIBAN_PAUSA_MIN_MS=350
# Si el turno queda mas lejos que esto, el envio se rechaza en vez de esperar.
# ANTIBAN_ESPERA_MAX_MS=60000
# Con tantos errores 463 en una hora se enfria la cuenta entera.
# ANTIBAN_UMBRAL_463_HORA=5

# Webhook receiver (opcional, puerto distinto al de Rust)
WEBHOOK_PORT=4001
WEBHOOK_SECRET=winsibot_secret

# Panel web (reemplaza al viejo panel PHP) — servido en este puerto,
# API + WebSocket + el build de web/ todo junto, mismo origen
DASHBOARD_PORT=4002

# Base de datos
DATABASE_URL=postgresql://winsi:password@localhost:5432/winsibot


# Raid (#raid): cada cuantas horas aparece el jefe de mundo, y cuantos minutos
# se queda antes de escapar.
# RAID_CADA_H=6
# RAID_DURA_MIN=60

# Texto a voz (#tts), sin internet. Por defecto usa el primer motor que haya:
# Piper (si PIPER_MODEL apunta a una voz .onnx), espeak-ng/espeak
# (Termux: pkg install espeak), la voz de Windows, o say en macOS.
# TTS_MOTOR=auto
# PIPER_MODEL=
# TTS_VOZ=

# Misc
NODE_ENV=development
LOG_LEVEL=info